generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum AppointmentStatus {
  Pending             @map("PENDING")
  Confirmed           @map("CONFIRMED")
  Rescheduled         @map("RESCHEDULED")
  CancellationPending @map("CANCELLATION_PENDING")
  Cancelled           @map("CANCELLED")
  Completed           @map("COMPLETED")
}

enum AppointmentCancellationRequestStatus {
  PENDING
  PROCESSING
  APPROVED
}

enum AccountDeletionRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  Pending       @map("PENDING")
  Paid          @map("PAID")
  Failed        @map("FAILED")
  Expired       @map("EXPIRED")
  RefundPending @map("REFUND_PENDING")
  Refunded      @map("REFUNDED")
  RefundFailed  @map("REFUND_FAILED")
}

model User {
  id                        String                     @id @default(uuid())
  customerReference         String                     @unique
  firstName                 String
  surname                   String
  email                     String                     @unique
  address                   String
  mobileNumber              String
  passwordHash              String
  role                      UserRole                   @default(CUSTOMER)
  appointments              Appointment[]
  reviews                   Review[]
  refreshTokens             RefreshToken[]
  passwordResetTokens       PasswordResetToken[]
  accountDeletionRequest    AccountDeletionRequest?
  payments                  Payment[]
  weatherAlertNotifications WeatherAlertNotification[]
  requests                  CustomerRequest[] @relation("CustomerRequests")
  adminAuditLogs            AdminAuditLog[]   @relation("AdminAuditLogs")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  avatarUrl                 String?
  avatarObjectKey           String?
}

model Service {
  id              String        @id @default(uuid())
  name            String        @unique
  description     String
  durationMinutes Int
  pricePence      Int
  active          Boolean       @default(true)
  appointments    Appointment[]
  payments        Payment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Appointment {
  id                      String                          @id @default(uuid())
  userId                  String
  user                    User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId               String?
  serviceRef              Service?                        @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  dateTime                DateTime
  durationMinutes         Int                             @default(60)
  status                  AppointmentStatus               @default(Pending)
  service                 String?
  notes                   String?
  confirmedAt             DateTime?
  cancelledAt             DateTime?
  cancellationRequestedAt DateTime?
  deleteRequestedAt       DateTime?
  rescheduledFrom         DateTime?
  deletionRequest         AppointmentDeletionRequest?
  cancellationRequest     AppointmentCancellationRequest?
  review                  Review?
  payments                Payment[]
  createdAt               DateTime                        @default(now())
  updatedAt               DateTime                        @updatedAt

  @@index([userId])
  @@index([dateTime])
  @@index([serviceId])
}

model AppointmentCancellationRequest {
  id            String                               @id @default(uuid())
  appointmentId String                               @unique
  appointment   Appointment                          @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tokenHash     String                               @unique
  status        AppointmentCancellationRequestStatus @default(PENDING)
  expiresAt     DateTime
  approvedAt    DateTime?
  createdAt     DateTime                             @default(now())
  updatedAt     DateTime                             @updatedAt

  @@index([status, expiresAt])
}

model Payment {
  id                      String        @id @default(uuid())
  appointmentId           String
  appointment             Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId               String
  service                 Service       @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  stripeCheckoutSessionId String?       @unique
  stripePaymentIntentId   String?       @unique
  stripeInvoiceId         String?       @unique
  stripeRefundId          String?       @unique
  amountPence             Int
  currency                String        @default("gbp")
  status                  PaymentStatus @default(Pending)
  checkoutExpiresAt       DateTime?
  paidAt                  DateTime?
  failedAt                DateTime?
  refundRequestedAt       DateTime?
  refundedAt              DateTime?
  refundFailedAt          DateTime?
  refundFailureReason     String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([appointmentId, createdAt(sort: Desc)])
  @@index([userId])
  @@index([status])
}

model Review {
  id            String      @id @default(uuid())
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerName  String
  avatarUrl     String
  rating        Int
  comment       String
  petName       String
  petBreed      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([createdAt(sort: Desc)])
}

model AppointmentDeletionRequest {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AccountDeletionRequest {
  id          String                       @id @default(uuid())
  userId      String                       @unique
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String                       @unique
  status      AccountDeletionRequestStatus @default(PENDING)
  expiresAt   DateTime
  cancelledAt DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([expiresAt])
}

model WeatherSafetyState {
  id                     String    @id @default("pawside")
  location               String
  temperatureC           Float
  feelsLikeC             Float?
  humidity               Int?
  condition              String?
  bookingBlocked         Boolean   @default(false)
  alertStartedAt         DateTime?
  safetyRestoredAt       DateTime?
  restoredAlertStartedAt DateTime?
  weatherObservedAt      DateTime
  checkedAt              DateTime
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

model WeatherAlertNotification {
  id                            String    @id @default(uuid())
  userId                        String
  user                          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertStartedAt                DateTime
  temperatureC                  Float
  lastAttemptedAt               DateTime?
  deliveredAt                   DateTime?
  safetyRestoredLastAttemptedAt DateTime?
  safetyRestoredDeliveredAt     DateTime?
  createdAt                     DateTime  @default(now())

  @@unique([userId, alertStartedAt])
  @@index([alertStartedAt])
}

model CustomerRequest {
  id           String    @id @default(uuid())
  customerId   String
  customer     User      @relation(name: "CustomerRequests", fields: [customerId], references: [id], onDelete: Cascade)
  requestType  String    // CANCELLATION, ACCOUNT_DELETION, RESCHEDULE
  status       String    // PENDING, APPROVED, REJECTED
  requestedAt  DateTime  @default(now())
  processedAt  DateTime?
  processedBy  String?
  adminNotes   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String
  adminUser    User     @relation(name: "AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Cascade)
  action       String
  customerId   String?
  requestId    String?
  ipAddress    String?
  createdAt    DateTime @default(now())
}
