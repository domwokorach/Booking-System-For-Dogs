generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AppointmentStatus {
  Pending     @map("PENDING")
  Confirmed   @map("CONFIRMED")
  Rescheduled @map("RESCHEDULED")
  Cancelled   @map("CANCELLED")
}

enum AccountDeletionRequestStatus {
  PENDING
  CANCELLED
  COMPLETED
}

model User {
  id           String        @id @default(uuid())
  firstName    String
  surname      String
  email        String        @unique
  address      String
  mobileNumber String
  passwordHash String
  appointments Appointment[]
  reviews      Review[]
  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  accountDeletionRequest AccountDeletionRequest?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Service {
  id              String        @id @default(uuid())
  name            String        @unique
  description     String
  durationMinutes Int
  active          Boolean       @default(true)
  appointments    Appointment[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Appointment {
  id               String            @id @default(uuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceId        String?
  serviceRef       Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  dateTime         DateTime
  durationMinutes  Int               @default(60)
  status           AppointmentStatus @default(Pending)
  service          String?
  notes            String?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  deleteRequestedAt DateTime?
  rescheduledFrom  DateTime?
  deletionRequest  AppointmentDeletionRequest?
  review            Review?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([dateTime])
  @@index([serviceId])
}

model Review {
  id            String      @id @default(uuid())
  customerId    String
  customer      User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customerName  String
  avatarUrl     String
  rating        Int
  comment       String
  petName       String
  petBreed      String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([customerId])
  @@index([createdAt(sort: Desc)])
}

model AppointmentDeletionRequest {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  tokenHash     String      @unique
  expiresAt     DateTime
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model AccountDeletionRequest {
  id          String                       @id @default(uuid())
  userId      String                       @unique
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String                       @unique
  status      AccountDeletionRequestStatus @default(PENDING)
  expiresAt   DateTime
  cancelledAt DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([expiresAt])
}
