DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dog_booking?schema=public"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173"

JWT_SECRET="change-this-to-a-very-long-random-string"
JWT_EXPIRES_IN="7d"

# Resend booking emails
RESEND_API_KEY="re_your_new_resend_api_key"
EMAIL_FROM="Pawside <onboarding@resend.dev>"
# Booking confirmation and cancellation notifications are sent here.
BOOKING_EMAIL_TO="dominicolanya@gmail.com"

STORAGE_PROVIDER="gcs"

# Fill these values to enable GCS uploads.
AWS_REGION="us-east-1"
AWS_S3_BUCKET="your-bucket-name"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"

GCP_PROJECT_ID=""
GCP_BUCKET=""
GCP_KEY_FILE=""
