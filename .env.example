# Vite exposes only variables prefixed with VITE_. Publishable Stripe keys are
# public identifiers; never place STRIPE_SECRET_KEY in a frontend environment.
VITE_API_URL="http://localhost:3000"
VITE_SOCKET_URL="http://localhost:3000"
VITE_BUSINESS_TIME_ZONE="Europe/London"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_replace_with_your_publishable_key"
