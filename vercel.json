{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "installCommand": "pnpm install --no-frozen-lockfile"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/main.ts",
      "installCommand": "pnpm install --no-frozen-lockfile"
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
